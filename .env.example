# ratatoskr-platform — every configuration variable, with its built-in default.
#
# Precedence: built-in role defaults, then these environment variables. There is no configuration
# file. Nesting is spelled with a DOUBLE underscore.
#
# On the deployment target these are set through each unit's EnvironmentFile; the templates in
# deploy/systemd/*.conf.example carry only the variables a deployment must state.
#
# Copy to .env for local use. .env is gitignored; .env.example is not.
# Never put a real secret in .env.example.

# ---- operator listener (every role) ---------------------------------------------------------
# Default 127.0.0.1:9464 (edge), :9465 (ingest), :9466 (scheduler) — deny by default.
# THE DEPLOYMENT SETS 0.0.0.0:<port>: the metrics stack on the target is a container on the Docker
# bridge, and a host loopback port is not reachable from there. What bounds the exposure is
# IPAddressAllow= in each systemd unit, not the bind address (ADR-0013).
# The admin plane must never be published through an ingress; it serves /metrics.
#RATATOSKR__ADMIN__BIND=127.0.0.1:9464

# ---- public listener (edge and ingest; never scheduler) --------------------------------------
# Required for edge AND ingest; rejected at startup for scheduler (ARCHITECTURE.md S18).
# Ingest carries no compiled default -- 8081 is taken on the deployment target and a default is a
# promise that a port is free -- so rule V1 refuses to start it until this is set. Its allocation
# is 8181.
#RATATOSKR__PUBLIC__BIND=127.0.0.1:8080
#RATATOSKR__PUBLIC__REQUEST_TIMEOUT_SECONDS=15
#RATATOSKR__PUBLIC__MAX_BODY_BYTES=1048576
# The two limits ARCHITECTURE.md S14 requires beside the timeout and the body bound.
# Concurrency: excess requests are REFUSED with 503, never queued. A queue on four shared cores
# turns a load spike into a timeout for every caller instead of a refusal for some. 1..=4096.
#RATATOSKR__PUBLIC__MAX_CONCURRENT_REQUESTS=64
# Per actor, applied AFTER the caller is identified -- by user on edge, by source on ingest. It
# cannot be applied earlier: behind a tunnel that adds its own headers there is no client identity a
# process may trust, so a per-address limit here would be a limit on the tunnel. 1..=100000.
# Zero is refused rather than treated as "off": it reads as disabled and behaves as refuse-everything.
#RATATOSKR__PUBLIC__ACTOR_REQUESTS_PER_MINUTE=120

# ---- database (all three roles; required by every one of them since milestone 9) -------------
# The WHOLE URL is a secret, because a PostgreSQL URL carries its password in the user information.
# It is therefore never Debug-printed and never reaches the effective-configuration log line.
# Absent means the process refuses to start: every route edge serves reads or writes a database,
# ingest resolves every signal against one, and scheduler reads its schedules from one.
#RATATOSKR__DATABASE__URL=postgres://ratatoskr_edge:CHANGE-ME@127.0.0.1:5432/ratatoskr
# A ceiling, not a target. PostgreSQL's own max_connections is the real limit and three roles share
# it; a pool that can exhaust the server is a self-inflicted outage. 1..=100, default 10.
#RATATOSKR__DATABASE__MAX_CONNECTIONS=10
# Bounded well below the public request timeout, so a saturated pool surfaces as a fast, truthful
# failure rather than a request that times out with no explanation. 1..=30, default 5.
#RATATOSKR__DATABASE__ACQUIRE_TIMEOUT_SECONDS=5

# ---- bus (ratatoskr-edge ONLY) ---------------------------------------------------------------
# Edge publishes the outbox and consumes operation events, and refuses to start without a broker.
# Ingest and scheduler set NEITHER of these: they write commands into operations.outbox and publish
# none of them, so edge runs the only pump and holds the only NATS credential (ADR-0013).
# NEVER embed a credential in the URL (no user:password@): startup rule V13 refuses one, for the
# same reason rule V10 refuses one in the collector endpoint.
#RATATOSKR__BUS__URL=nats://127.0.0.1:4222
# The file holding this role's NATS nkey SEED. A path, never the value: the seed stays out of the
# environment and out of every log line, and its permissions are the file system's job. Rule V16
# refuses a relative path -- it would resolve against the unit's working directory -- and refuses a
# file that is not there, so `<binary> check-config` catches a missing credential before ExecStart.
# Absent means an anonymous connection, which is what compose.yaml serves and what no deployment
# should. See deploy/nats/README.md.
#RATATOSKR__BUS__NKEY_SEED_PATH=/etc/ratatoskr/edge.nkey

# ---- identity (ratatoskr-edge only) ----------------------------------------------------------
# The Ed25519 PUBLIC key of ratatoskr-telegram, base64 with padding, decoding to exactly 32 bytes.
# NOT a secret: Platform holds only the public half, so it can verify an assertion and cannot issue
# one (ADR-0011). Absent means POST /v1/sessions/telegram refuses and GET /v1/capabilities reports
# telegram.mini_app unavailable, so a client can tell before it tries.
#RATATOSKR__IDENTITY__ASSERTION_KEY=
# Where a browser is sent after a provider callback has been relayed. Configured, never taken from
# the callback: every parameter of that request is attacker-supplied, so a redirect target read out
# of one is an open redirect (ADR-0012).
#RATATOSKR__IDENTITY__OAUTH_COMPLETION_URL=https://ratatoskr.example/oauth/done

# ---- retention (ratatoskr-edge only; it runs the sweep) --------------------------------------
# How long each MECHANICAL table is kept -- a deduplication marker, a delivered message, a security
# decision, an occurrence. Deleting one of those changes nothing a person can see.
# operations.operations is deliberately absent: operation history is what a user reads at
# GET /v1/operations/{id}, so how long it is kept is a product decision, and no milestone owns it.
#
# The inbox window may not be shorter than the event stream's own retention of 7 days -- startup
# rule V17 refuses it. A record deleted while its message is still redeliverable is a deduplication
# guarantee that has quietly stopped holding, and the symptom is an event applied twice.
#RATATOSKR__RETENTION__INBOX_DAYS=30
# Published rows only. A dead-lettered row is evidence of work a client was told had been accepted
# and that nobody delivered, and it is kept until a person resolves it.
#RATATOSKR__RETENTION__OUTBOX_DAYS=30
# The longest by an order of magnitude, and the only one of the four that is a policy rather than a
# mechanism: everything else goes once it can no longer affect correctness, and this goes when
# somebody decides how long an incident may go unnoticed.
#RATATOSKR__RETENTION__AUDIT_DAYS=365
# Also how far back an operator may rewind a schedule's next_due_at before the rewind republishes
# instead of being suppressed.
#RATATOSKR__RETENTION__SCHEDULE_OCCURRENCE_DAYS=90

# ---- operations ------------------------------------------------------------------------------
# How long an operation may stand unterminated with no observed fact — no status change, no
# progress entry — before the reaper in ratatoskr-edge marks it failed with the stable code
# `platform.operation.stale` (ADR-0014). Liveness is the newest observed fact, so a worker that
# reports progress is never harvested however long the work takes. One day by default; rule V19
# accepts 3600..=2592000 and refuses zero outright. To disable the reaper, set the ceiling.
#RATATOSKR__OPERATIONS__STALE_AFTER_SECONDS=86400

# ---- shutdown --------------------------------------------------------------------------------
# drain: keep serving while readiness already reports 503, so the load balancer removes this
# thing routing to this process stops before the listener closes. On the target that is cloudflared,
# which retries a closed connection. drain + grace may not exceed 120s, and the systemd units set
# TimeoutStopSec above that, so a drain is never SIGKILLed halfway.
#RATATOSKR__SHUTDOWN__DRAIN_SECONDS=5
#RATATOSKR__SHUTDOWN__GRACE_SECONDS=25

# ---- telemetry -------------------------------------------------------------------------------
#RATATOSKR__TELEMETRY__LOG_FORMAT=json          # json | pretty
#RATATOSKR__TELEMETRY__LOG_FILTER=info,tower_http=info,hyper=warn,h2=warn

# OTLP span export. Absent means no exporter — spans are still created and trace_id is still a real
# W3C id in every log line and every error envelope.
# http and https both work. NEVER embed a credential here (no user:password@, no ?token=): a URL is
# not a secret type and its Debug rendering reaches the effective-configuration log line. Startup
# rule V10 refuses to start on one. Collector authentication goes in the header variable below.
#RATATOSKR__TELEMETRY__OTLP__ENDPOINT=https://collector.example:4317
#RATATOSKR__TELEMETRY__OTLP__TIMEOUT_SECONDS=5

# Collector authentication. Supply it through the unit's EnvironmentFile, which systemd reads as
# root and which is 0640 root:ratatoskr-<role>; never from a file in the repository. Header names
# must match ^[a-z0-9-]{1,64}$.
#RATATOSKR__TELEMETRY__OTLP__HEADERS__AUTHORIZATION=

# ---- build identity (set by the container build, not by an operator) --------------------------
# RATATOSKR_GIT_SHA is read at COMPILE time via option_env!; setting it at runtime does nothing.
