# ratatoskr-platform — every configuration variable, with its built-in default.
#
# Precedence: built-in role defaults, then these environment variables. There is no configuration
# file at milestone 1. Nesting is spelled with a DOUBLE underscore.
#
# Copy to .env for local use. .env is gitignored; .env.example is not.
# Never put a real secret in .env.example.

# ---- operator listener (every role) ---------------------------------------------------------
# Default 127.0.0.1:9464 (edge), :9465 (ingest), :9466 (scheduler) — deny by default.
# A CONTAINER DEPLOYMENT MUST SET 0.0.0.0:<port>: the kubelet probes the pod IP, not loopback.
# The admin plane must never be published through an ingress; it serves /metrics.
#RATATOSKR__ADMIN__BIND=127.0.0.1:9464

# ---- public listener (ratatoskr-edge only at milestone 1) ------------------------------------
# Required for edge; rejected at startup for ingest and scheduler (ARCHITECTURE.md S18).
#RATATOSKR__PUBLIC__BIND=127.0.0.1:8080
#RATATOSKR__PUBLIC__REQUEST_TIMEOUT_SECONDS=15
#RATATOSKR__PUBLIC__MAX_BODY_BYTES=1048576

# ---- shutdown --------------------------------------------------------------------------------
# drain: keep serving while readiness already reports 503, so the load balancer removes this
# instance before the listener closes. 0 is legal locally and guarantees 502s in a rolling deploy.
#RATATOSKR__SHUTDOWN__DRAIN_SECONDS=5
#RATATOSKR__SHUTDOWN__GRACE_SECONDS=25

# ---- telemetry -------------------------------------------------------------------------------
#RATATOSKR__TELEMETRY__LOG_FORMAT=json          # json | pretty
#RATATOSKR__TELEMETRY__LOG_FILTER=info,tower_http=info,hyper=warn,h2=warn

# OTLP span export. Absent means no exporter — spans are still created and trace_id is still a real
# W3C id in every log line and every error envelope.
# http and https both work. NEVER embed a credential here (no user:password@, no ?token=): a URL is
# not a secret type and its Debug rendering reaches the effective-configuration log line. Startup
# rule V10 refuses to start on one. Collector authentication goes in the header variable below.
#RATATOSKR__TELEMETRY__OTLP__ENDPOINT=https://collector.example:4317
#RATATOSKR__TELEMETRY__OTLP__TIMEOUT_SECONDS=5

# Collector authentication. THE ONLY SECRET AT MILESTONE 1. Supply it from the orchestrator's secret
# store, never from a file in the repository. Header names must match ^[a-z0-9-]{1,64}$.
#RATATOSKR__TELEMETRY__OTLP__HEADERS__AUTHORIZATION=

# ---- build identity (set by the container build, not by an operator) --------------------------
# RATATOSKR_GIT_SHA is read at COMPILE time via option_env!; setting it at runtime does nothing.
