# Install on the separate verifier as /etc/ratatoskr/offhost-drill.env, mode 0600, owner root:root.
# Never install this file or the identity on the Raspberry Pi.
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=https://s3.example.invalid
RATATOSKR_OFFHOST_BUCKET=CHANGE-ME
RATATOSKR_OFFHOST_PREFIX=ratatoskr-platform
RATATOSKR_OFFHOST_AGE_IDENTITY_FILE=/etc/ratatoskr/offhost-recovery.agekey
RATATOSKR_OFFHOST_DRILL_CONTAINER=ratatoskr-offhost-drill-postgres
RATATOSKR_OFFHOST_DRILL_DATABASE=ratatoskr_offhost_drill
