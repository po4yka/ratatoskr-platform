[Unit]
Description=Ratatoskr Platform — off-host backup restore drill
Documentation=https://github.com/po4yka/ratatoskr-platform/blob/main/deploy/backup/README.md
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/ratatoskr/offhost-drill.env
ExecStart=/usr/local/bin/ratatoskr-offhost-drill.sh

Nice=10
IOSchedulingClass=idle
CPUQuota=100%
TimeoutStartSec=3600

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ratatoskr-offhost-drill /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
