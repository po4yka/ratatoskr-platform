# Install as /etc/ratatoskr/offhost-backup.env, mode 0600, owner root:root. Never commit the real
# file. The S3 credential needs only ListBucket, GetObject and PutObject below this backup prefix.
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=https://s3.example.invalid
RATATOSKR_OFFHOST_BUCKET=CHANGE-ME
RATATOSKR_OFFHOST_PREFIX=ratatoskr-platform
# This is a public age recipient, not a private identity. Its matching identity stays off the Pi.
RATATOSKR_OFFHOST_AGE_RECIPIENT=age1change-me
RATATOSKR_BORG_REPOSITORY=/mnt/backup/borg
