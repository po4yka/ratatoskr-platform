[Unit]
Description=Ratatoskr Platform — database dump
Documentation=https://github.com/po4yka/ratatoskr-platform/blob/main/deploy/README.md
# PostgreSQL is a container on this host (milestone 10), so the ordering is on the runtime and the
# dump reaches the server through `docker exec`. `Requires=` is deliberately absent: a dump that
# cannot reach the database should fail its own run, not refuse to be scheduled.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# root, because the dump runs through `docker exec` and reaching the docker socket is a root
# privilege on this host. The script itself holds no database credential: it enters the container as
# the cluster's own superuser over a unix socket inside it.
User=root
ExecStart=/usr/local/bin/ratatoskr-dump.sh

# A dump reads the whole database. Bounded so it competes with the services rather than starving
# them: this is a background job on a four-core host that is also serving requests.
Nice=10
IOSchedulingClass=idle
CPUQuota=100%

# A dump that hangs must not hold the timer's next run out, and must not hold a transaction open
# against a database three services are writing to.
TimeoutStartSec=3600

# The dump directory is the one path this may write.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/mnt/nvme/backups/ratatoskr /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
