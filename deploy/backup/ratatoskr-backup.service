[Unit]
Description=Ratatoskr Platform — database dump
Documentation=https://github.com/po4yka/ratatoskr-platform/blob/main/deploy/README.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/bin/ratatoskr-dump.sh

# A dump reads the whole database. Bounded so it competes with the services rather than starving
# them: this is a background job on a four-core host that is also serving requests.
Nice=10
IOSchedulingClass=idle
CPUQuota=100%

# A dump that hangs must not hold the timer's next run out, and must not hold a transaction open
# against a database three services are writing to.
TimeoutStartSec=3600

# The dump directory is the one path this may write.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/mnt/nvme/backups/ratatoskr
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
