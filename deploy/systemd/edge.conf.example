# /etc/ratatoskr/edge.conf — root:ratatoskr-edge 0640.
#
# systemd reads this as root and hands the values to a process running as `ratatoskr-edge`, so the
# database password is never world-readable and never on a command line. A `LoadCredential=` and
# a configuration loader that reads files would be better still, and is the upgrade path: today
# `platform_core::config` reads the environment only.
#
# Every variable and its built-in default is in `.env.example` at the repository root. Only the ones
# a deployment must state are here.

# The operator plane. 0.0.0.0 and not loopback, because the metrics stack is a container on the
# Docker bridge and a host loopback port is not reachable from there — the exposure is bounded by
# `IPAddressAllow=` in the unit, not by the bind address.
RATATOSKR__ADMIN__BIND=0.0.0.0:9464

# The public API. Loopback, because `cloudflared` runs on this host and reaches it there. If
# cloudflared is ever moved into a container this becomes 0.0.0.0 and the unit's IPAddressAllow=
# becomes the only thing between the public API and the LAN.
RATATOSKR__PUBLIC__BIND=127.0.0.1:8080
# The gateway's transfer and stream budgets are the public listener's ceiling; individual route
# classes are narrowed below and enforced before any loopback request starts.
RATATOSKR__PUBLIC__REQUEST_TIMEOUT_SECONDS=300
RATATOSKR__PUBLIC__MAX_BODY_BYTES=104857600

# Incomplete resumable archives survive Edge restart on the durable NVMe mount. This directory is
# private to ratatoskr-edge and is writable through the unit's otherwise read-only filesystem.
RATATOSKR__ARCHIVE_STAGING__ROOT=/mnt/nvme/ratatoskr/archive-staging
# The largest archive a device may prepare (rule V21: 1048576..=10737418240). Larger declarations
# are refused with 413. It is not the request-body ceiling above: an archive arrives as many chunk
# requests of at most 16 MiB each. Staging needs about twice this much free space on the mount above
# per in-flight archive, because the chunks and the assembled copy coexist until the receiver has
# the bytes.
RATATOSKR__ARCHIVE_STAGING__MAX_ARCHIVE_BYTES=2147483648
# How often the staging reaper sweeps (rule V23: 30..=3600 seconds). Each sweep removes the staging
# of transfers that expired, failed, finalized or whose operation ended ten minutes ago, and
# unowned `rst_*` directories older than an hour, 200 of each kind at most, and it re-checks that
# the root is writable and the volume holds twice the ceiling above.
RATATOSKR__ARCHIVE_STAGING__SWEEP_INTERVAL_SECONDS=300

# Domain APIs are loopback-only. Edge owns the public prefixes, validates the session and mints
# only x-ratatoskr-user-id, optional x-ratatoskr-device-id and x-ratatoskr-device-kind, and
# x-correlation-id for each request.
#
# Each upstream address below is bound by the OWNING service's own listener, not by its operator
# listener (XR-021 R2-01): knowledge 8091 is Knowledge's API listener (RATATOSKR__API__LISTEN_ADDRESS),
# github 8092 is GitHub's API listener, chatgpt 8096 and claude 8097 are the receipt listeners
# (RATATOSKR__RECEIPT__LISTEN_ADDRESS), and notes 8099 is the domain API listener of ratatoskr-notes
# (RATATOSKR__API__LISTEN_ADDRESS). The notes route is control; Edge gives
# /v1/notes/connections/{id}/blobs, .../changes and .../manifest the transfer budget, with the body
# limits of notes (16 MiB an upload chunk, 2 MiB a change batch, 32 MiB a manifest), and it handles
# POST /v1/notes/connections itself: it mints the operation and forwards the body, which holds
# Obsidian secrets, without keeping any part of it. Only a paired device reaches those three device
# paths, and a device reaches no other notes path than the connect. Vault 8093, social 8094 and ai 8095 have no implementing
# service yet, so nothing listens there and Edge reports those capabilities stale on purpose: that is
# the truthful answer, and a route is not removed to hide it.
RATATOSKR__GATEWAY__ROUTES__KNOWLEDGE__PREFIX=/v1/k
RATATOSKR__GATEWAY__ROUTES__KNOWLEDGE__LISTENER=127.0.0.1:8091
RATATOSKR__GATEWAY__ROUTES__KNOWLEDGE__CLASS=stream
RATATOSKR__GATEWAY__ROUTES__GITHUB__PREFIX=/v1/gh
RATATOSKR__GATEWAY__ROUTES__GITHUB__LISTENER=127.0.0.1:8092
RATATOSKR__GATEWAY__ROUTES__GITHUB__CLASS=control
RATATOSKR__GATEWAY__ROUTES__VAULT__PREFIX=/v1/vault
RATATOSKR__GATEWAY__ROUTES__VAULT__LISTENER=127.0.0.1:8093
RATATOSKR__GATEWAY__ROUTES__VAULT__CLASS=transfer
RATATOSKR__GATEWAY__ROUTES__SOCIAL__PREFIX=/v1/social
RATATOSKR__GATEWAY__ROUTES__SOCIAL__LISTENER=127.0.0.1:8094
RATATOSKR__GATEWAY__ROUTES__SOCIAL__CLASS=stream
RATATOSKR__GATEWAY__ROUTES__AI__PREFIX=/v1/ai
RATATOSKR__GATEWAY__ROUTES__AI__LISTENER=127.0.0.1:8095
RATATOSKR__GATEWAY__ROUTES__AI__CLASS=stream
RATATOSKR__GATEWAY__ROUTES__CHATGPT__PREFIX=/v1/chatgpt
RATATOSKR__GATEWAY__ROUTES__CHATGPT__LISTENER=127.0.0.1:8096
RATATOSKR__GATEWAY__ROUTES__CHATGPT__CLASS=transfer
RATATOSKR__GATEWAY__ROUTES__CHATGPT__ARCHIVE_RECEIPT_PATH=/v1/ai-archives/receipt
RATATOSKR__GATEWAY__ROUTES__CLAUDE__PREFIX=/v1/claude
RATATOSKR__GATEWAY__ROUTES__CLAUDE__LISTENER=127.0.0.1:8097
RATATOSKR__GATEWAY__ROUTES__CLAUDE__CLASS=transfer
RATATOSKR__GATEWAY__ROUTES__CLAUDE__ARCHIVE_RECEIPT_PATH=/v1/ai-archives/receipt
RATATOSKR__GATEWAY__ROUTES__NOTES__PREFIX=/v1/notes
RATATOSKR__GATEWAY__ROUTES__NOTES__LISTENER=127.0.0.1:8099
RATATOSKR__GATEWAY__ROUTES__NOTES__CLASS=control
# The sites service, ratatoskr-sites (SITE-025). Its content routes, /v1/sites/{site}/content and
# below, are the public class of ADR-0017: GET and HEAD only, no credential read, an anonymous claim,
# and a bucket for each client and for each site before the proxy. Every other sites path needs a
# session. The class below is the budget of the route.
RATATOSKR__GATEWAY__ROUTES__SITES__PREFIX=/v1/sites
RATATOSKR__GATEWAY__ROUTES__SITES__LISTENER=127.0.0.1:8100
RATATOSKR__GATEWAY__ROUTES__SITES__CLASS=control

# The channel-digests read API, behind GET /v1/channel-digests/{subscriptions,results}. Both keys or
# neither (rule V22). The listener is loopback on the allocated port 8098; the secret equals the
# service's RATATOSKR__AUTH__SERVICE_SECRET and lives in this file's 0640 root:ratatoskr-edge
# EnvironmentFile mode like the database URL below. Without them the three read routes answer 503
# and the command routes keep working.
RATATOSKR__CHANNEL_DIGESTS__LISTENER=127.0.0.1:8098
RATATOSKR__CHANNEL_DIGESTS__SERVICE_SECRET=CHANGE-ME

# The whole URL is a secret: a PostgreSQL URL carries its password in the user information.
RATATOSKR__DATABASE__URL=postgres://ratatoskr_edge:CHANGE-ME@127.0.0.1:5432/ratatoskr

# The bus. The credential is a path, never a value: rule V13 refuses a URL with user information,
# and rule V16 refuses a relative path or a file that is not there.
RATATOSKR__BUS__URL=nats://127.0.0.1:4222
RATATOSKR__BUS__NKEY_SEED_PATH=/etc/ratatoskr/edge.nkey

# The Ed25519 PUBLIC key of `ratatoskr-telegram`, base64 with padding (ADR-0011). Platform holds
# only the public half, so this is not a secret. The placeholder below is refused at startup (rule
# V14, `check-config` names `identity.assertion_key`) until it is replaced: derive the real value on
# the host with `ratatoskr-telegram-webhook assertion-key public <seed file>`; the whole procedure is
# in deploy/README.md, "The Telegram assertion key". Delete the line to run without the Mini App:
# absent means `/v1/sessions/telegram` refuses and `GET /v1/capabilities` reports
# `telegram.mini_app` unavailable.
RATATOSKR__IDENTITY__ASSERTION_KEY=CHANGE-ME

# Where a browser is sent after a provider callback has been relayed. Configured, never taken from
# the callback: every parameter of that request is attacker-supplied (ADR-0012).
#RATATOSKR__IDENTITY__OAUTH_COMPLETION_URL=https://ratatoskr.example/oauth/done

# The stale-operation reaper (ADR-0014). The compiled default of one day is what this deployment
# runs; state it only to move the window.
#RATATOSKR__OPERATIONS__STALE_AFTER_SECONDS=86400

RATATOSKR__TELEMETRY__LOG_FORMAT=json

# Envelope allowlist for domain schedule registrations. ratatoskr-channel-digests registers its daily
# digest at worker start; ratatoskr-github stays allowlisted with no producer wired. The NATS ACL
# (deploy/nats/ratatoskr.conf) is what limits who may publish the subject at all, and the envelope
# producer must equal the registration's service_name.
#
# Operator prerequisite for the digest schedule: RATATOSKR__SCHEDULE__OWNER_USER_ID, set on the
# channel-digests worker, must name a user that exists in identity.users. Platform has no system
# principal: every occurrence creates an operation owned by the schedule's owner, who is the only
# one able to read it. Platform checks the id when the registration arrives: an owner that is not an
# active user in identity.users is rejected, no schedule is stored, and the refusal is written to
# identity.audit_events (action schedule.registration, outcome denied) with the log class
# schedule_owner_unknown. A wrong id therefore shows up as a worker that registered nothing, not as
# operations that belong to nobody.
RATATOSKR__SCHEDULING__ALLOWED_REGISTRARS=["ratatoskr-github","ratatoskr-channel-digests"]
